# Optional webapp-only settings. Copy to webapp.env (passed to the webapp container as env_file).
# Only uncomment what you need - several of these must NOT be set to an empty string.
# Full reference: https://trigger.dev/docs/self-hosting/env/webapp

# Restrict who can sign up / log in (regex). Strongly recommended.
# WHITELISTED_EMAILS=^(you@corp\.local|teammate@corp\.local)$
# Auto-promote matching users to admin on signup (regex).
# ADMIN_EMAILS=^you@corp\.local$

# ---- Email: real mail server (Exchange or any SMTP relay) ----
# Mail goes to Mailpit while docker-compose.mailpit.yml is in COMPOSE_FILE (.env): that overlay
# overrides everything in this block. To switch: uncomment and fill in this block, remove
# ":docker-compose.mailpit.yml" from COMPOSE_FILE, then `docker compose up -d`.
#
# Exchange, authenticated submission (port 587, STARTTLS): use a service mailbox. FROM_EMAIL must
# be that mailbox (or one it has "Send As" rights on), or Exchange rejects the message.
# Exchange anonymous relay connector instead: SMTP_PORT=25 and leave SMTP_USER/SMTP_PASSWORD
# commented out (don't set them to empty strings).
# If sending fails with 'Missing credentials for "PLAIN"', the connector advertises AUTH: either
# disable auth on that connector or use the authenticated mailbox setup above.
# EMAIL_TRANSPORT=smtp
# SMTP_HOST=exchange.corp.local
# SMTP_PORT=587
## SMTP_SECURE: false = STARTTLS (ports 587/25), true = implicit TLS (port 465 only)
# SMTP_SECURE=false
# SMTP_USER=svc-trigger@corp.local
# SMTP_PASSWORD=
# FROM_EMAIL=svc-trigger@corp.local
# REPLY_TO_EMAIL=svc-trigger@corp.local
#
# Alert emails (run failures, deployments) use separate settings; usually the same values:
# ALERT_EMAIL_TRANSPORT=smtp
# ALERT_SMTP_HOST=exchange.corp.local
# ALERT_SMTP_PORT=587
# ALERT_SMTP_SECURE=false
# ALERT_SMTP_USER=svc-trigger@corp.local
# ALERT_SMTP_PASSWORD=
# ALERT_FROM_EMAIL=svc-trigger@corp.local
# ALERT_REPLY_TO_EMAIL=svc-trigger@corp.local
#
# If Exchange's certificate comes from an internal CA, the webapp (Node.js) won't trust it.
# Put the CA certificate (PEM) in trigger.dev/certs/, uncomment the certs volume in
# docker-compose.local.yml, and set:
# NODE_EXTRA_CA_CERTS=/certs/corp-ca.pem

# Allow opening the magic link in a different browser than the one that requested it.
# MAGIC_LINK_SAME_BROWSER_REQUIRED=false

# Concurrency defaults for new environments/orgs
# DEFAULT_ENV_EXECUTION_CONCURRENCY_LIMIT=100
# DEFAULT_ORG_EXECUTION_CONCURRENCY_LIMIT=100
