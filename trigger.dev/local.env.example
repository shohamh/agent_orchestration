# ---- Local additions: append to .env after the upstream .env.example ----
#   cp .env.example .env && cat local.env.example >> .env && ./generate-secrets.sh
# (kept separate so .env.example stays a pristine upstream copy that update-upstream.sh can replace)

# Load the unmodified upstream compose files + our overrides with a plain `docker compose ...`.
# Drop docker-compose.no-bind-mounts.yml on Linux servers (it's only for Docker hosts that
# can't bind-mount host files, e.g. Docker Desktop without File Sharing configured).
# docker-compose.mailpit.yml is a local inbox for login emails (http://localhost:8025). Remove it
# once webapp.env points at a real mail server (see webapp.env.example).
COMPOSE_PATH_SEPARATOR=:
COMPOSE_FILE=webapp/docker-compose.yml:worker/docker-compose.yml:docker-compose.local.yml:docker-compose.no-bind-mounts.yml:docker-compose.mailpit.yml

# Pin every image so the offline bundle is reproducible. Upgrade = bump these (TRIGGER_IMAGE_TAG
# is bumped for you by scripts/update-upstream.sh).
TRIGGER_IMAGE_TAG=v4.8.3
MINIO_IMAGE_TAG=2025.7.23
DOCKER_PROXY_IMAGE_TAG=v0.4.1
MAILPIT_IMAGE_TAG=v1.27.10

# Webapp heap in MiB (~80% of the RAM you give the webapp).
NODE_MAX_OLD_SPACE_SIZE=1600

# 9090 (upstream default) falls in a Windows/Hyper-V reserved port range on some machines.
CLICKHOUSE_NATIVE_HOST_PORT=19090

# Offline only (see ../OFFLINE.md): digest-pinned base images mirrored into the local registry.
# DEPLOY_BASE_IMAGES / DEPLOY_BUILD_BASE_IMAGES go in webapp.env, not here.
