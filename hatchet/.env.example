# Copy to .env and adjust. Changing HATCHET_HOST / ports after first start requires
# re-running setup-config with a fresh config volume AND re-issuing tokens.

HATCHET_VERSION=v0.114.2

# Hostname/IP that browsers and workers use to reach this machine.
# localhost for a single box; the server's LAN IP/DNS name in the offline network.
HATCHET_HOST=localhost
HATCHET_DASHBOARD_PORT=8080
HATCHET_GRPC_PORT=7077

POSTGRES_PASSWORD=hatchet
POSTGRES_HOST_PORT=5435

# Seeded on first start only. Change before first `up`.
HATCHET_ADMIN_EMAIL=admin@example.com
HATCHET_ADMIN_PASSWORD=Admin123!!

# Filled in by ./scripts/create-token.sh
HATCHET_CLIENT_TOKEN=
