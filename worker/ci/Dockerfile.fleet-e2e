FROM node:22-bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl python3 \
    && rm -rf /var/lib/apt/lists/*

COPY dist/worker/agent-worker-x86_64-unknown-linux-musl /usr/local/bin/agent-worker
COPY worker/ci/fleet-e2e-entrypoint.sh /usr/local/bin/fleet-e2e-entrypoint
RUN chmod 0755 /usr/local/bin/agent-worker /usr/local/bin/fleet-e2e-entrypoint

USER node
ENTRYPOINT ["/usr/local/bin/fleet-e2e-entrypoint"]
