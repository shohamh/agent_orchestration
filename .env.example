# Settings for the root docker-compose.yml; copy to .env. Values here take precedence over board/.env.

# Shared by the board, the flow host and the flow workers. Generate one: openssl rand -hex 32
FLOW_HOST_TOKEN=
# Hatchet client token for flow workers; copy from hatchet/.env.
HATCHET_WORKER_CLIENT_TOKEN=

# Which engines to use. Start each one from its own folder, with docker-compose.agents.yml in its
# COMPOSE_FILE, and remove the rest from these lines:
#   flow worker containers (hatchet, prefect; Trigger.dev has none)
COMPOSE_PROFILES=hatchet,prefect
#   engines the flow host keeps flows active on
FLOW_BACKENDS=hatchet,prefect,trigger
#   engine SDK in the board image (only the Hatchet tab needs one)
ENGINES=hatchet

# Addresses on the shared network; an engine's tab also needs its credential in board/.env.
HATCHET_GRPC=hatchet-engine:7070
HATCHET_URL=http://hatchet-dashboard:80
TRIGGER_URL=http://webapp:3000
PREFECT_API_URL=http://prefect-server:4200/api
FLOW_HOST_URL=http://flow-host:8095
FLOW_RELAY_URL=http://flow-host:8097
