# Copy to .env. Fill only the backends you want on the board.

BOARD_PORT=8090

# Login. The board can start coding agents that run commands on this PC: set a password before
# exposing it (LAN, Tailscale Serve/Funnel). Empty = no login (localhost-only use).
BOARD_PASSWORD=
# Optional extra signing secret; changing it (or the password) signs everyone out.
BOARD_SECRET=

# Hatchet: an API token (hatchet/scripts/create-token.sh writes one to hatchet/.env)
HATCHET_CLIENT_TOKEN=
# HATCHET_GRPC=host.docker.internal:7077
# HATCHET_URL=http://host.docker.internal:8080

# Trigger.dev: the environment secret key the board operates on (dashboard -> API keys), e.g. tr_prod_...
TRIGGER_SECRET_KEY=
# Development environment key for local coding sessions (trigger dev runs on this PC).
TRIGGER_DEV_SECRET_KEY=
# TRIGGER_URL=http://host.docker.internal:8030

# Prefect: REST API of the Prefect server (default http://host.docker.internal:4200/api; set empty to disable)
# PREFECT_API_URL=
